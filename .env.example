# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local은 git에 올라가지 않습니다)
# 값을 바꾸면 dev 서버를 반드시 재시작해야 반영됩니다.

VITE_API_BASE_URL=https://api.geojero.com

# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키
# 플랫폼 > Web 에 아래 도메인이 등록돼 있어야 합니다.
#   http://localhost:5173
#   https://geojero-client.vercel.app
VITE_KAKAO_MAP_KEY=
